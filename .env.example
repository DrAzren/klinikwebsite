# ─────────────────────────────────────────────────────────────────────────────
# Klinik Nissa platform — environment template
# Copy to .env.local (development) or set in your hosting provider (production).
# NEVER commit real values. Every integration is optional in development: when
# unset, a clearly labelled DEMO adapter is used instead (see docs/CREDENTIALS.md).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, sitemap, canonical URLs)
SITE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (Project Settings → Database → Connection
# string → "Transaction pooler", port 6543). Leave EMPTY locally to use the
# embedded PGlite database in .data/pglite (auto-migrated and demo-seeded).
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ── Encryption (REQUIRED in production) ───────────────────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts screening answers/contact details, clinical notes, careers data and MFA secrets.
# Store a copy in the clinic's password manager — losing it makes encrypted data unreadable.
APP_ENCRYPTION_KEY=

# ── Clinic contact ────────────────────────────────────────────────────────────
# WhatsApp number used for all booking CTAs (verify before launch).
CLINIC_WHATSAPP_NUMBER=60126081411
# Careers applications are emailed here (confirm the clinic's Gmail address).
CAREERS_EMAIL=
# Comma-separated authorised clinicians who receive minimal screening alerts.
SCREENING_NOTIFY_EMAILS=
# Comma-separated admin fallbacks for operational notifications.
ADMIN_NOTIFY_EMAILS=
EMAIL_FROM="Klinik Nissa <no-reply@your-domain.my>"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# e.g. Google Workspace / Gmail with an App Password (requires 2-Step Verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Google Drive & Sheets ─────────────────────────────────────────────────────
# Option A (recommended): service account JSON, base64-encoded. Add the service
# account's email as a member (Content manager) of the clinic's Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Option B: OAuth client + refresh token for the clinic Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Private Drive folder for screening records (inside a Shared Drive for option A).
GOOGLE_DRIVE_SCREENING_FOLDER_ID=
# Access-controlled Google Sheet for screening administration (no names/contacts are written).
GOOGLE_SHEETS_SCREENING_ID=
GOOGLE_SHEETS_SCREENING_TAB=Saringan
# Default Drive folder for staff document uploads, plus optional per-category folders:
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=
# {"supplier_invoice":"<folderId>","payment_receipt":"<folderId>","lab_invoice":"<folderId>","stock":"…","maintenance":"…","admin":"…"}
GOOGLE_DRIVE_DOCUMENT_FOLDERS_JSON=

# ── Private object storage (Supabase Storage) ─────────────────────────────────
# Create a PRIVATE bucket. The service-role key is server-side only — never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=klinik-private
# LOCAL_STORAGE_DIR=.data/uploads

# ── Operations ────────────────────────────────────────────────────────────────
# Secret for the scheduled /api/cron/jobs endpoint (Authorization: Bearer <secret>).
CRON_SECRET=
# MFA is enforced automatically in production. Set true to also enforce in development.
# MFA_REQUIRED=
# Development-only banner stating content is unverified (auto: shown when not production).
# SHOW_PREVIEW_BANNER=
# Development-only: preview the unverified panel candidate list (labelled DEMO).
# DEMO_PREVIEW_UNVERIFIED_PANELS=
BOOK_PURCHASE_URL=https://www.bookcafe.my/collections/terbaru/products/dr-saya-boleh-sembuh-ke-
# Optional ambient hero loop (WebM/MP4 in /public/motion), desktop only, skipped for reduced motion.
# NEXT_PUBLIC_HERO_VIDEO=/motion/hero-loop.webm
